{
  "steps": [
    {
      "key": "compile_context",
      "kind": "RETRIEVAL",
      "instruction": "Compile the bounded chapter context for the target chapter: approved outline (see ## outlineRef), hard canon, current story/character/relationship/world state, timeline constraints, active threads and promises, recent story memory, relevant historical memory, narrative DNA and style notes, and relevant external references. Bounded selection with provenance and budget; never scan the full manuscript.",
      "inputs": {
        "chapterNumber": "$input.chapterNumber",
        "outlineRef": "$input.outlineRef"
      }
    },
    {
      "key": "plan",
      "kind": "AGENT",
      "ref": "chapter-planner",
      "instruction": "You are the scene planner. Read the compiled chapter context (## context) and the run inputs. Produce a structured scene plan for the chapter: purpose, cast, objectives, conflict, stakes, permitted revelations, the approved outline reference, and source pins. Planning authority (highest to lowest): explicit author instruction > current approved chapter/scene outline > current arc/saga state > canon > character/relationship/world state > timeline and continuity constraints > recent story memory > relevant historical memory > synopsis > general creativity. The plan must bind to the approved outline (see ## outlineRef); never contradict hard canon silently. Respond with JSON only, matching the plan-schema contract.",
      "outputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "additionalProperties": true,
        "description": "Structured scene plan produced by the chapter-planner agent, bound to the approved outline and source pins.",
        "properties": {
          "cast": {
            "items": {
              "minLength": 1,
              "type": "string"
            },
            "type": "array"
          },
          "conflict": {
            "minLength": 1,
            "type": "string"
          },
          "objectives": {
            "items": {
              "minLength": 1,
              "type": "string"
            },
            "type": "array"
          },
          "outlineRef": {
            "minLength": 1,
            "type": "string"
          },
          "permittedRevelations": {
            "items": {
              "minLength": 1,
              "type": "string"
            },
            "type": "array"
          },
          "purpose": {
            "minLength": 1,
            "type": "string"
          },
          "sourcePins": {
            "additionalProperties": true,
            "properties": {
              "outlineVersion": {
                "minLength": 1,
                "type": "string"
              },
              "workflowVersion": {
                "minimum": 1,
                "type": "integer"
              }
            },
            "required": [
              "workflowVersion",
              "outlineVersion"
            ],
            "type": "object"
          },
          "stakes": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "purpose",
          "cast",
          "objectives",
          "conflict",
          "stakes",
          "permittedRevelations",
          "outlineRef",
          "sourcePins"
        ],
        "title": "Chapter scene plan",
        "type": "object"
      },
      "inputs": {
        "chapterNumber": "$input.chapterNumber",
        "outlineRef": "$input.outlineRef",
        "context": "$steps.compile_context.json"
      }
    },
    {
      "key": "validate_plan",
      "kind": "VALIDATOR",
      "inputs": {
        "subject": "$steps.plan.json"
      },
      "outputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "additionalProperties": true,
        "description": "Structured scene plan produced by the chapter-planner agent, bound to the approved outline and source pins.",
        "properties": {
          "cast": {
            "items": {
              "minLength": 1,
              "type": "string"
            },
            "type": "array"
          },
          "conflict": {
            "minLength": 1,
            "type": "string"
          },
          "objectives": {
            "items": {
              "minLength": 1,
              "type": "string"
            },
            "type": "array"
          },
          "outlineRef": {
            "minLength": 1,
            "type": "string"
          },
          "permittedRevelations": {
            "items": {
              "minLength": 1,
              "type": "string"
            },
            "type": "array"
          },
          "purpose": {
            "minLength": 1,
            "type": "string"
          },
          "sourcePins": {
            "additionalProperties": true,
            "properties": {
              "outlineVersion": {
                "minLength": 1,
                "type": "string"
              },
              "workflowVersion": {
                "minimum": 1,
                "type": "integer"
              }
            },
            "required": [
              "workflowVersion",
              "outlineVersion"
            ],
            "type": "object"
          },
          "stakes": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "purpose",
          "cast",
          "objectives",
          "conflict",
          "stakes",
          "permittedRevelations",
          "outlineRef",
          "sourcePins"
        ],
        "title": "Chapter scene plan",
        "type": "object"
      }
    },
    {
      "key": "write",
      "kind": "AGENT",
      "ref": "chapter-writer",
      "instruction": "You are the chapter writer. Write the chapter draft from the scene plan (## plan) and the compiled chapter context (## context). Canon authority: explicit author correction/instruction > approved canon > published chapter facts > world/character/relationship rules > timeline > approved plot plan > agent instructions > references > model creativity. Conflicts must be surfaced, never silently reconciled. Respond with JSON only, matching the draft-schema contract: the full chapter prose plus optional title and scene-break offsets.",
      "outputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "additionalProperties": true,
        "description": "A chapter draft artifact produced by the chapter-writer agent.",
        "properties": {
          "prose": {
            "minLength": 200,
            "type": "string"
          },
          "sceneBreaks": {
            "items": {
              "minimum": 0,
              "type": "integer"
            },
            "type": "array"
          },
          "title": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "prose"
        ],
        "title": "Chapter draft",
        "type": "object"
      },
      "inputs": {
        "chapterNumber": "$input.chapterNumber",
        "outlineRef": "$input.outlineRef",
        "plan": "$steps.plan.json",
        "context": "$steps.compile_context.json"
      }
    },
    {
      "key": "validate_draft",
      "kind": "VALIDATOR",
      "inputs": {
        "subject": "$steps.write.json"
      },
      "outputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "additionalProperties": true,
        "description": "A chapter draft artifact produced by the chapter-writer agent.",
        "properties": {
          "prose": {
            "minLength": 200,
            "type": "string"
          },
          "sceneBreaks": {
            "items": {
              "minimum": 0,
              "type": "integer"
            },
            "type": "array"
          },
          "title": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "prose"
        ],
        "title": "Chapter draft",
        "type": "object"
      }
    },
    {
      "key": "review_vs",
      "kind": "AGENT",
      "ref": "voice-style-reviewer",
      "instruction": "You are the voice/style reviewer. Read the draft (## draft) and the compiled context (## context). Check voice, style, and narrative rhythm against the workspace's narrative DNA (tone, cadence, point-of-view discipline, dialogue texture). Emit structured findings; every finding MUST cite its evidence as {source, version, span}. Set needsCorrection=true only when a major or blocking finding requires a rewrite. Respond with JSON only, matching the findings-schema contract.",
      "outputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "additionalProperties": true,
        "description": "Structured review findings with evidence, produced by the voice-style-reviewer and final-reviewer agents. Every finding carries its evidence; needsCorrection drives the bounded-correction CONDITIONs.",
        "properties": {
          "findings": {
            "items": {
              "additionalProperties": true,
              "properties": {
                "category": {
                  "minLength": 1,
                  "type": "string"
                },
                "evidence": {
                  "additionalProperties": true,
                  "properties": {
                    "source": {
                      "minLength": 1,
                      "type": "string"
                    },
                    "span": {
                      "minLength": 1,
                      "type": "string"
                    },
                    "version": {
                      "minLength": 1,
                      "type": "string"
                    }
                  },
                  "required": [
                    "source",
                    "version",
                    "span"
                  ],
                  "type": "object"
                },
                "remediation": {
                  "minLength": 1,
                  "type": "string"
                },
                "rule": {
                  "minLength": 1,
                  "type": "string"
                },
                "severity": {
                  "enum": [
                    "info",
                    "minor",
                    "major",
                    "blocking"
                  ],
                  "type": "string"
                }
              },
              "required": [
                "category",
                "severity",
                "rule",
                "evidence",
                "remediation"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "needsCorrection": {
            "type": "boolean"
          }
        },
        "required": [
          "findings",
          "needsCorrection"
        ],
        "title": "Review findings",
        "type": "object"
      },
      "inputs": {
        "draft": "$steps.write.json",
        "context": "$steps.compile_context.json"
      }
    },
    {
      "key": "validate_vs",
      "kind": "VALIDATOR",
      "inputs": {
        "subject": "$steps.review_vs.json"
