{"$schema":"http://json-schema.org/draft-07/schema#","additionalProperties":true,"description":"Structured review findings with evidence, produced by the voice-style-reviewer and final-reviewer agents. Every finding carries its evidence; needsCorrection drives the bounded-correction CONDITIONs.","properties":{"findings":{"items":{"additionalProperties":true,"properties":{"category":{"minLength":1,"type":"string"},"evidence":{"additionalProperties":true,"properties":{"source":{"minLength":1,"type":"string"},"span":{"minLength":1,"type":"string"},"version":{"minLength":1,"type":"string"}},"required":["source","version","span"],"type":"object"},"remediation":{"minLength":1,"type":"string"},"rule":{"minLength":1,"type":"string"},"severity":{"enum":["info","minor","major","blocking"],"type":"string"}},"required":["category","severity","rule","evidence","remediation"],"type":"object"},"type":"array"},"needsCorrection":{"type":"boolean"}},"required":["findings","needsCorrection"],"title":"Review findings","type":"object"}