NODE_ENV=development
PORT=3000
# Production: set the exact browser origin (required with NODE_ENV=production).
# PUBLIC_ORIGIN=https://novelforge.example
# Native reverse-proxy deployment: restrict the API bind and trust only local hops.
# API_HOST=127.0.0.1
# TRUST_PROXY=loopback
DATABASE_URL=postgresql://novelforge:novelforge@postgres:5432/novelforge
REDIS_URL=redis://redis:6379
OMNIROUTE_BASE_URL=http://host.docker.internal:20128
OMNIROUTE_API_KEY=replace_me

# Gateway routing policy: PRIORITY | WEIGHTED | ROUND_ROBIN |
# LEAST_LATENCY | FAILOVER. Applies to every request unless a caller
# overrides it. WEIGHTED and LEAST_LATENCY only differ from PRIORITY
# once gateway weight / observed latency are populated.
AI_ROUTING_STRATEGY=PRIORITY
APP_ENCRYPTION_KEY=replace_with_strong_key

# --- S3-compatible object storage (MinIO for local dev) ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=novelforge
S3_ACCESS_KEY_ID=replace_me
S3_SECRET_ACCESS_KEY=replace_me

# --- docker-compose.yml (local dev infrastructure) ---
# Defaults below are for local development only; never use in production.
# Host port mappings (container ports stay 5432/6379):
POSTGRES_PORT=5432
REDIS_PORT=6379
# PostgreSQL credentials — must match DATABASE_URL user/password above:
POSTGRES_USER=novelforge
POSTGRES_PASSWORD=novelforge
POSTGRES_DB=novelforge

# --- web (Nuxt) ---
# The web dev server is pinned to 3001 in nuxt.config.ts: the API also
# defaults to 3000, so sharing the port would fail to bind.
# Origin of the Fastify API that the Nitro /api/** proxy forwards to.
NUXT_API_BASE=http://localhost:3000
