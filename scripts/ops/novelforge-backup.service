[Unit]
Description=NovelForge PostgreSQL daily custom archive
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/usr/local/lib/novelforge-ops
EnvironmentFile=/etc/novelforge/backup.env
Environment=PATH=/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/local/bin/node /usr/local/lib/novelforge-ops/postgres-daily-backup.mjs
UMask=0077
TimeoutStartSec=30min
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/backups/novelforge
ProtectHome=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
