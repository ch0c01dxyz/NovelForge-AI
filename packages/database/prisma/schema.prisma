// NovelForge platform schema (Phase 1).
// Scope: platform entities only (users, sessions, workspaces, memberships,
// novels, novel_settings, audit_logs) per docs/04-data/DATA-MODEL-BLUEPRINT.md.
// Story/manuscript/AI entities arrive with their phases.

generator client {
  provider   = "prisma-client"
  output     = "../generated/prisma"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
}

enum MembershipRole {
  OWNER
  ADMIN
  AUTHOR
  EDITOR
  VIEWER
}

enum NovelStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

/// Platform-level role. Deliberately separate from MembershipRole: a
/// workspace OWNER must not be able to manage global LLM gateway
/// credentials just by creating a workspace (ADR-0004/ADR-0005).
enum PlatformRole {
  SUPER_ADMIN
}

model User {
  id                  String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email               String           @unique
  passwordHash        String           @map("password_hash")
  displayName         String           @map("display_name")
  /// Null for ordinary users. Grants platform-wide administration
  /// (gateway/model registry) — never implied by workspace membership.
  platformRole        PlatformRole?    @map("platform_role")
  createdAt           DateTime         @default(now()) @map("created_at")
  updatedAt           DateTime         @updatedAt @map("updated_at")
  sessions            Session[]
  memberships         Membership[]
  ownedWorkspaces     Workspace[]      @relation("WorkspaceOwner")
  createdNovels       Novel[]          @relation("NovelCreator")
  auditEntries        AuditLog[]       @relation("AuditActor")
  createdChapters     Chapter[]        @relation("ChapterCreator")
  authoredChapterVers ChapterVersion[] @relation("ChapterVersionAuthor")
  createdAgents       Agent[]          @relation("AgentCreator")
  authoredAgentVers   AgentVersion[]   @relation("AgentVersionAuthor")
  createdSkills       Skill[]          @relation("SkillCreator")
  authoredSkillVers   SkillVersion[]   @relation("SkillVersionAuthor")
  createdWorkflows    Workflow[]       @relation("WorkflowCreator")
  authoredFlowVers    WorkflowVersion[] @relation("WorkflowVersionAuthor")
  authoredSynopses    Synopsis[]        @relation("SynopsisCreator")
  authoredSagas       Saga[]            @relation("SagaCreator")
  authoredOutlineVers OutlineVersion[]  @relation("OutlineVersionCreator")
  triggeredRuns       WorkflowRun[]    @relation("WorkflowRunTrigger")
  createdReferences   Reference[]      @relation("ReferenceCreator")
  authoredRefVers     ReferenceVersion[] @relation("ReferenceVersionCreator")
  createdEntities     StoryEntity[]    @relation("StoryEntityCreator")
  createdCanonFacts   CanonFact[]      @relation("CanonFactCreator")
  createdFactSources  CanonFactSource[] @relation("CanonFactSourceCreator")
  proposedCanon       CanonProposal[]  @relation("CanonProposalAuthor")
  decidedCanon        CanonProposal[]  @relation("CanonProposalDecider")
  storyEvents         StoryEvent[]     @relation("StoryEventCreator")
  timelineEvents      TimelineEvent[]  @relation("TimelineEventCreator")
  storyThreads        StoryThread[]    @relation("StoryThreadCreator")
  storyThreadEvents   StoryThreadEvent[] @relation("StoryThreadEventCreator")
  storyPromises       StoryPromise[]   @relation("StoryPromiseCreator")
  approvedEdges       CausalEdge[]     @relation("CausalEdgeApprover")
  createdCharacters   Character[]      @relation("CharacterCreator")
  createdBonds        Bond[]           @relation("BondCreator")
  createdAntagonists  Antagonist[]     @relation("AntagonistCreator")

  @@map("users")
}

model Session {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // Opaque session tokens are stored hashed only (ADR-0002); plaintext
  // never touches the database.
  tokenHash String    @unique @map("token_hash")
  userId    String    @map("user_id") @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime  @map("expires_at")
  createdAt DateTime  @default(now()) @map("created_at")
  revokedAt DateTime? @map("revoked_at")

  @@index([userId])
  @@map("sessions")
}

model Workspace {
  id           String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name         String
  slug         String       @unique
  ownerId      String       @map("owner_id") @db.Uuid
  owner        User         @relation("WorkspaceOwner", fields: [ownerId], references: [id])
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")
  memberships  Membership[]
  novels       Novel[]
  auditEntries AuditLog[]
  agents       Agent[]
  skills       Skill[]
  workflows    Workflow[]
  references   Reference[]
  retrievals   RetrievalAudit[]
  canonFacts   CanonFact[]
  proposals    CanonProposal[]
  storyEvents  StoryEvent[]
  timelineEvents TimelineEvent[]
  storyThreads StoryThread[]
  storyPromises StoryPromise[]
  causalEdges  CausalEdge[]
  characters   Character[]
  stances      RelationshipStance[]
  bonds        Bond[]
  interactions MeaningfulInteraction[]
  antagonists  Antagonist[]

  @@map("workspaces")
}

model Membership {
  id          String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String         @map("workspace_id") @db.Uuid
  workspace   Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId      String         @map("user_id") @db.Uuid
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        MembershipRole
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  @@unique([workspaceId, userId])
  @@index([userId])
  @@map("memberships")
}

model Novel {
  id          String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String         @map("workspace_id") @db.Uuid
  workspace   Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  title       String
  slug        String
  status      NovelStatus    @default(DRAFT)
  createdById String         @map("created_by_id") @db.Uuid
  createdBy   User           @relation("NovelCreator", fields: [createdById], references: [id])
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")
  settings    NovelSettings?
  chapters    Chapter[]
  workflows   Workflow[]
  references  Reference[]
  retrievals  RetrievalAudit[]
  entities    StoryEntity[]
  canonFacts  CanonFact[]
  proposals   CanonProposal[]
  synopses    Synopsis[]
  sagas       Saga[]
  outlineNodes OutlineNode[]
  outlineVersions OutlineVersion[]
  horizons    PlanningHorizon[]
  storyEvents StoryEvent[]
  timelineEvents TimelineEvent[]
  threads     StoryThread[]
  promises    StoryPromise[]
  causalEdges CausalEdge[]
  characters  Character[]
  bonds       Bond[]
  dnaProfile  NarrativeDnaProfile?
  policies    NarrativePolicy[]
  antagonists Antagonist[]

  @@unique([workspaceId, slug])
  @@index([workspaceId])
  @@map("novels")
}

// Intentional JSONB: per-novel knobs are open-ended by design and always
// read/written as a unit (blueprint: "JSONB only where flexibility is
// intentional"). Structured story truth gets its own tables in later phases.
model NovelSettings {
  novelId   String   @id @map("novel_id") @db.Uuid
  novel     Novel    @relation(fields: [novelId], references: [id], onDelete: Cascade)
  settings  Json     @default("{}")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("novel_settings")
}

// Immutable audit fact. No update/delete path is exposed by the repository
// layer (CLAUDE.md §33: admin actions auditable; ADR-0003).
model AuditLog {
  id          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorUserId String?    @map("actor_user_id") @db.Uuid
  actor       User?      @relation("AuditActor", fields: [actorUserId], references: [id])
  workspaceId String?    @map("workspace_id") @db.Uuid
  workspace   Workspace? @relation(fields: [workspaceId], references: [id])
  action      String
  entityType  String     @map("entity_type")
  entityId    String?    @map("entity_id") @db.Uuid
  payload     Json       @default("{}")
  createdAt   DateTime   @default(now()) @map("created_at")

  @@index([workspaceId, createdAt])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

// ==================== Manuscript (Phase 2) ====================
// Scope: chapters/scenes + immutable chapter versions per
// docs/04-data/DATA-MODEL-BLUEPRINT.md §Manuscript. Branches/checkpoints
// are Phase 11 (story versioning); scene versions deferred until editing
// pressure demands them.

enum ChapterStatus {
  DRAFT
  IN_REVIEW
  PUBLISHED
}

model Chapter {
  id               String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  novelId          String           @map("novel_id") @db.Uuid
  novel            Novel            @relation(fields: [novelId], references: [id], onDelete: Cascade)
  // Chapter order within the novel. Unique per novel; reorder swaps numbers
  // inside a transaction.
  number           Int
  title            String
  status           ChapterStatus    @default(DRAFT)
  // Points at the current immutable version; null until first save.
  // onDelete: SetNull — deleting a chapter drops its versions (Cascade on
  // ChapterVersion.chapter), so the pointer must not block that cascade.
  currentVersionId String?          @unique @map("current_version_id") @db.Uuid
  currentVersion   ChapterVersion?  @relation("CurrentChapterVersion", fields: [currentVersionId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  wordCount        Int              @default(0) @map("word_count")
  createdById      String           @map("created_by_id") @db.Uuid
  createdBy        User             @relation("ChapterCreator", fields: [createdById], references: [id])
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")
  versions         ChapterVersion[] @relation("ChapterVersions")
  scenes           Scene[]
  outlineNodes     OutlineNode[]
  storyEvents      StoryEvent[]

  @@unique([novelId, number])
  @@index([novelId, status])
  @@map("chapters")
}

// Immutable manuscript snapshot (blueprint: "immutable revision/audit
// records"). Every save creates a new row; content is never mutated in
// place. Optimistic concurrency: save carries the version number the
// author last saw; a mismatch is a 409.
model ChapterVersion {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  chapterId         String   @map("chapter_id") @db.Uuid
  chapter           Chapter  @relation("ChapterVersions", fields: [chapterId], references: [id], onDelete: Cascade)
  // Monotonic per chapter, enforced by (chapterId, number) unique.
  number            Int
  content           String   @db.Text
  wordCount         Int      @map("word_count")
  // Brief change note (autosave, manual save, import).
  note              String?
  authorId          String   @map("author_id") @db.Uuid
  author            User     @relation("ChapterVersionAuthor", fields: [authorId], references: [id])
  createdAt         DateTime @default(now()) @map("created_at")
  // Opposite side of Chapter.currentVersion pointer.
  currentForChapter Chapter? @relation("CurrentChapterVersion")
  factSources       CanonFactSource[]

  @@unique([chapterId, number])
  @@index([chapterId, createdAt])
  @@map("chapter_versions")
}

model Scene {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  chapterId String   @map("chapter_id") @db.Uuid
  chapter   Chapter  @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  number    Int
  title     String
  summary   String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([chapterId, number])
  @@index([chapterId])
  @@map("scenes")

  outlineNodes OutlineNode[]
}

// ==================== AI Infrastructure (Phase 3) ====================
// Scope: gateways, discovered model catalog, model-profile mappings, and
// logical generation/attempt records per docs/06-ai/OMNIROUTE-INTEGRATION.md
// and CLAUDE.md §6. Gateway credentials are stored encrypted only; the
// ciphertext never leaves the server (CLAUDE.md §14).

enum GatewayHealth {
  UNKNOWN
  HEALTHY
  DEGRADED
  DOWN
}

/** Capability abstractions application code requests (ADR-005). */
enum ModelProfile {
  CREATIVE_WRITER
  DEEP_PLANNER
  CONTINUITY_REVIEWER
  FAST_CLASSIFIER
  STRUCTURED_EXTRACTOR
  LONG_CONTEXT_REVIEWER
  EMBEDDING
}

enum GenerationStatus {
  PENDING
  IN_PROGRESS
  SUCCEEDED
  /// Stream interrupted / partial output — never treated as success.
  INCOMPLETE
  FAILED
}

enum AttemptStatus {
  SUCCEEDED
  FAILED
  TIMEOUT
  RATE_LIMITED
}

/** Error classification drives retry/fallback decisions (CLAUDE.md §27). */
enum ErrorCategory {
  NONE
  /// Timeout, connection reset, 5xx — plausibly transient.
  TRANSIENT
  RATE_LIMIT
  AUTH
  /// Malformed request/schema — retrying cannot help.
  INVALID_REQUEST
  UNSUPPORTED
  DETERMINISTIC
  INTERNAL
}

model AIGateway {
  id                   String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                 String        @unique
  baseUrl              String        @map("base_url")
  /// AES-256-GCM ciphertext (iv:tag:data). Never selected into API responses.
  credentialCiphertext String        @map("credential_ciphertext")
  enabled              Boolean       @default(true)
  /// Lower value = preferred when routing by priority.
  priority             Int           @default(100)
  weight               Int           @default(1)
  timeoutMs            Int           @default(60000) @map("timeout_ms")
  maxRetries           Int           @default(2) @map("max_retries")
  health               GatewayHealth @default(UNKNOWN)
  lastHealthCheckAt    DateTime?     @map("last_health_check_at")
  lastErrorAt          DateTime?     @map("last_error_at")
  lastErrorCategory    ErrorCategory? @map("last_error_category")
  /// Circuit-breaker input: reset on success, incremented on failure.
  consecutiveFailures  Int           @default(0) @map("consecutive_failures")
  /// Last observed round-trip latency; drives LEAST_LATENCY routing.
  latencyMs            Int?          @map("latency_ms")
  createdAt            DateTime      @default(now()) @map("created_at")
  updatedAt            DateTime      @updatedAt @map("updated_at")
  models               AIModel[]
  attempts             GenerationAttempt[]

  @@index([enabled, priority])
  @@map("ai_gateways")
}

/// Normalized local catalog of models discovered from a gateway.
/// Model identifiers are data, never code constants (ADR-005).
model AIModel {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  gatewayId     String    @map("gateway_id") @db.Uuid
  gateway       AIGateway @relation(fields: [gatewayId], references: [id], onDelete: Cascade)
  /// Provider model string, e.g. "gpt-4o-mini".
  modelId       String    @map("model_id")
  displayName   String?   @map("display_name")
  /// e.g. ["chat", "streaming", "embeddings", "vision"].
  capabilities  String[]
  contextWindow Int?      @map("context_window")
  enabled       Boolean   @default(true)
  discoveredAt  DateTime  @default(now()) @map("discovered_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  profileMaps   ModelProfileMapping[]

  @@unique([gatewayId, modelId])
  @@index([enabled])
  @@map("ai_models")
}

/// Admin mapping: which concrete model serves a capability profile.
model ModelProfileMapping {
  id        String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  profile   ModelProfile
  modelRef  String       @map("model_ref") @db.Uuid
  model     AIModel      @relation(fields: [modelRef], references: [id], onDelete: Cascade)
  /// Lower = preferred among models mapped to the same profile.
  priority  Int          @default(100)
  enabled   Boolean      @default(true)
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  @@unique([profile, modelRef])
  @@index([profile, enabled, priority])
  @@map("model_profile_mappings")
}

/// One logical AI request. Owned by NovelForge regardless of how many
/// transport attempts or upstream fallbacks OmniRoute performs.
model Generation {
  id              String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId     String?          @map("workspace_id") @db.Uuid
  novelId         String?          @map("novel_id") @db.Uuid
  userId          String?          @map("user_id") @db.Uuid
  task            String
  modelProfile    ModelProfile     @map("model_profile")
  status          GenerationStatus @default(PENDING)
  /// Prompt template version, when the request used a versioned prompt.
  promptVersion   String?          @map("prompt_version")
  /// Source identifiers used to build context (provenance, CLAUDE.md §7).
  contextSnapshot Json             @default("{}") @map("context_snapshot")
  inputTokens     Int?             @map("input_tokens")
  outputTokens    Int?             @map("output_tokens")
  latencyMs       Int?             @map("latency_ms")
  errorCategory   ErrorCategory?   @map("error_category")
  /// Sanitized message only — never credentials or raw provider bodies.
  errorMessage    String?          @map("error_message")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  completedAt     DateTime?        @map("completed_at")
  attempts        GenerationAttempt[]
  stepRuns        WorkflowStepRun[]
  retrievals      RetrievalAudit[] @relation("GenerationRetrieval")

  @@index([workspaceId, createdAt])
  @@index([novelId, createdAt])
  @@map("generations")
}

/// One transport attempt against one gateway/model.
model GenerationAttempt {
  id            String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  generationId  String        @map("generation_id") @db.Uuid
  generation    Generation    @relation(fields: [generationId], references: [id], onDelete: Cascade)
  attemptNumber Int           @map("attempt_number")
  gatewayId     String?       @map("gateway_id") @db.Uuid
  gateway       AIGateway?    @relation(fields: [gatewayId], references: [id], onDelete: SetNull)
  /// Resolved provider model string for this attempt.
  modelId       String?       @map("model_id")
  status        AttemptStatus
  errorCategory ErrorCategory @default(NONE) @map("error_category")
  errorMessage  String?       @map("error_message")
  latencyMs     Int?          @map("latency_ms")
  startedAt     DateTime      @default(now()) @map("started_at")
  endedAt       DateTime?     @map("ended_at")

  @@unique([generationId, attemptNumber])
  @@index([gatewayId, startedAt])
  @@map("generation_attempts")
}

// ==================== Agent / Skill / Workflow (Phase 4) ====================
// Agents (WHO), skills (HOW), workflows (orchestration) per CLAUDE.md §3 and
// docs/06-ai/AI-ORCHESTRATION.md.
//
// Versioning model matches Chapter/ChapterVersion (Phase 2): the definition
// row holds identity and a pointer to the current immutable version, and
// every edit appends a new version. A run stores the exact version numbers it
// used, so a replayed run is explainable after the definitions move on
// (CLAUDE.md §2.11 — every meaningful mutation is versioned and auditable).

/// Visibility scope. Platform agents are shared infrastructure; workspace
/// agents belong to one tenant and are invisible to every other tenant.
enum DefinitionScope {
  PLATFORM
  WORKSPACE
}

/// Kind of workspace-owned resource a SKILL step operates on.
enum SkillCategory {
  RETRIEVAL
  ANALYSIS
  TRANSFORM
  VALIDATION
}

enum AgentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum SkillStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum WorkflowStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum WorkflowRunStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
  /// Stopped at a HUMAN_APPROVAL step. Terminal for now: the run halts and
  /// nothing resumes it — a resume path (approve/reject + continue from the
  /// parked step) is not implemented yet. `completedAt` is left null on these
  /// rows so "parked" stays distinguishable from "done".
  AWAITING_APPROVAL
  CANCELLED
}

enum StepRunStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
  SKIPPED
  AWAITING_APPROVAL
}

/// An AI role: WHO performs a task (CLAUDE.md §3 "Agent").
model Agent {
  id               String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  scope            DefinitionScope  @default(WORKSPACE)
  /// Null for PLATFORM-scoped definitions; set for WORKSPACE-scoped ones.
  workspaceId      String?          @map("workspace_id") @db.Uuid
  workspace        Workspace?       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  /// Stable machine name, unique within its scope (lowercase kebab).
  key              String
  name             String
  description      String?
  status           AgentStatus      @default(DRAFT)
  /// Points at the current immutable version; null until first version.
  currentVersionId String?          @unique @map("current_version_id") @db.Uuid
  currentVersion   AgentVersion?    @relation("CurrentAgentVersion", fields: [currentVersionId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  createdById      String           @map("created_by_id") @db.Uuid
  createdBy        User             @relation("AgentCreator", fields: [createdById], references: [id])
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")
  versions         AgentVersion[]   @relation("AgentVersions")
  workflowSteps    WorkflowStepRun[] @relation("StepRunAgent")

  /// Scoped key. NOTE: PostgreSQL treats NULL as distinct, so this index
  /// does NOT constrain PLATFORM rows (workspaceId IS NULL) — it only
  /// enforces one key per workspace. A duplicate PLATFORM key is therefore
  /// possible at the database level; uniqueness there is enforced in the
  /// service layer (`gateDefinitionWrite` + `rethrowUnique`) rather than by
  /// a partial index, which Prisma cannot express in the schema.
  /// A WORKSPACE row and a PLATFORM row may legitimately share a key: the
  /// workspace row shadows the shared one at resolve time.
  @@unique([scope, workspaceId, key], name: "agent_scope_workspace_key")
  @@index([workspaceId, status])
  @@map("agents")
}

/// Immutable agent revision. Never updated in place.
model AgentVersion {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  agentId     String   @map("agent_id") @db.Uuid
  agent       Agent    @relation("AgentVersions", fields: [agentId], references: [id], onDelete: Cascade)
  /// Monotonic per agent, enforced by (agentId, number) unique.
  number      Int
  /// Task-oriented system instruction for this role.
  instructions String  @db.Text
  /// Model capability this agent asks for (never a provider model name).
  modelProfile ModelProfile @map("model_profile")
  /// Skill keys this agent may invoke. Explicit allowlist (SECURITY.md).
  skillKeys   String[] @map("skill_keys")
  /// Optional structured-output contract (JSON Schema subset).
  outputSchema Json?   @map("output_schema")
  /// Default sampling settings, merged under any per-run override.
  temperature Float?
  maxTokens   Int?     @map("max_tokens")
  createdById String   @map("created_by_id") @db.Uuid
  createdBy   User     @relation("AgentVersionAuthor", fields: [createdById], references: [id])
  createdAt   DateTime @default(now()) @map("created_at")
  currentFor  Agent?   @relation("CurrentAgentVersion")
  stepRuns    WorkflowStepRun[]

  @@unique([agentId, number])
  @@index([agentId, createdAt])
  @@map("agent_versions")
}

/// A reusable capability: HOW a task is performed (CLAUDE.md §3 "Skill").
model Skill {
  id               String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  scope            DefinitionScope  @default(WORKSPACE)
  workspaceId      String?          @map("workspace_id") @db.Uuid
  workspace        Workspace?       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  key              String
  name             String
  description      String?
  category         SkillCategory    @default(ANALYSIS)
  status           SkillStatus      @default(DRAFT)
  currentVersionId String?          @unique @map("current_version_id") @db.Uuid
  currentVersion   SkillVersion?    @relation("CurrentSkillVersion", fields: [currentVersionId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  createdById      String           @map("created_by_id") @db.Uuid
  createdBy        User             @relation("SkillCreator", fields: [createdById], references: [id])
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")
  versions         SkillVersion[]   @relation("SkillVersions")
  workflowSteps    WorkflowStepRun[] @relation("StepRunSkill")

  @@unique([scope, workspaceId, key], name: "skill_scope_workspace_key")
  @@index([workspaceId, status])
  @@map("skills")
}

model SkillVersion {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  skillId     String   @map("skill_id") @db.Uuid
  skill       Skill    @relation("SkillVersions", fields: [skillId], references: [id], onDelete: Cascade)
  number      Int
  /// Instruction describing how this capability is performed.
  instructions String  @db.Text
  /// Model capability this skill needs when it runs on its own.
  modelProfile ModelProfile @map("model_profile")
  outputSchema Json?   @map("output_schema")
  createdById String   @map("created_by_id") @db.Uuid
  createdBy   User     @relation("SkillVersionAuthor", fields: [createdById], references: [id])
  createdAt   DateTime @default(now()) @map("created_at")
  currentFor  Skill?   @relation("CurrentSkillVersion")
  stepRuns    WorkflowStepRun[]

  @@unique([skillId, number])
  @@index([skillId, createdAt])
  @@map("skill_versions")
}

/// Orchestration of agents, skills, retrieval and approvals (CLAUDE.md §3).
model Workflow {
  id               String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  scope            DefinitionScope  @default(WORKSPACE)
  workspaceId      String?          @map("workspace_id") @db.Uuid
  workspace        Workspace?       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  /// Scoped to a single novel when set; workspace-wide when null.
  novelId          String?          @map("novel_id") @db.Uuid
  novel            Novel?           @relation(fields: [novelId], references: [id], onDelete: Cascade)
  key              String
  name             String
  description      String?
  status           WorkflowStatus   @default(DRAFT)
  currentVersionId String?          @unique @map("current_version_id") @db.Uuid
  currentVersion   WorkflowVersion? @relation("CurrentWorkflowVersion", fields: [currentVersionId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  createdById      String           @map("created_by_id") @db.Uuid
  createdBy        User             @relation("WorkflowCreator", fields: [createdById], references: [id])
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")
  versions         WorkflowVersion[] @relation("WorkflowVersions")
  runs             WorkflowRun[]

  @@unique([scope, workspaceId, key], name: "workflow_scope_workspace_key")
  @@index([workspaceId, status])
  @@index([novelId])
  @@map("workflows")
}

/// Immutable workflow revision. `graph` is validated (acyclic, deterministic,
/// bounded) before the row is written; the executor re-validates on load so a
/// hand-edited or migrated row cannot bypass the checks (CLAUDE.md §19).
model WorkflowVersion {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workflowId  String   @map("workflow_id") @db.Uuid
  workflow    Workflow @relation("WorkflowVersions", fields: [workflowId], references: [id], onDelete: Cascade)
  number      Int
  /// { steps: [...], edges: [...], maxSteps: n } — see @novelforge/validation.
  graph       Json
  /// Snapshot of the keys this version references, for display and drift
  /// detection without re-walking the graph.
  agentKeys   String[] @map("agent_keys")
  skillKeys   String[] @map("skill_keys")
  createdById String   @map("created_by_id") @db.Uuid
  createdBy   User     @relation("WorkflowVersionAuthor", fields: [createdById], references: [id])
  createdAt   DateTime @default(now()) @map("created_at")
  currentFor  Workflow? @relation("CurrentWorkflowVersion")
  runs        WorkflowRun[]

  @@unique([workflowId, number])
  @@index([workflowId, createdAt])
  @@map("workflow_versions")
}

/// One execution of one workflow version.
model WorkflowRun {
  id                String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workflowId        String            @map("workflow_id") @db.Uuid
  workflow          Workflow          @relation(fields: [workflowId], references: [id], onDelete: Restrict)
  /// The exact version executed — the definitions may move on afterwards.
  workflowVersionId String            @map("workflow_version_id") @db.Uuid
  /// Both RESTRICT, not Cascade: run history is the execution audit trail —
  /// deleting a definition must not silently destroy the record of what it
  /// did (CLAUDE.md §2.11). deleteWorkflow maps the refusal to a 409.
  workflowVersion   WorkflowVersion   @relation(fields: [workflowVersionId], references: [id], onDelete: Restrict)
  workflowVersionNumber Int             @map("workflow_version_number")
  workspaceId       String?           @map("workspace_id") @db.Uuid
  novelId           String?           @map("novel_id") @db.Uuid
  triggeredById     String?           @map("triggered_by_id") @db.Uuid
  triggeredBy       User?             @relation("WorkflowRunTrigger", fields: [triggeredById], references: [id], onDelete: SetNull)
  status            WorkflowRunStatus @default(PENDING)
  /// Run inputs. Never contains credentials.
  input             Json              @default("{}")
  /// Final outputs of each step, keyed by step key.
  output            Json              @default("{}")
  errorMessage      String?           @map("error_message")
  /// Steps executed, bounded by the graph's maxSteps.
  stepCount         Int               @default(0) @map("step_count")
  startedAt         DateTime          @default(now()) @map("started_at")
  completedAt       DateTime?          @map("completed_at")
  steps             WorkflowStepRun[]

  @@index([workflowId, startedAt])
  // RESTRICT FK-check target: deleting a workflow version scans this column.
  @@index([workflowVersionId])
  @@index([workspaceId, startedAt])
  // SetNull trigger column (see the note on WorkflowStepRun below).
  @@index([triggeredById])
  @@map("workflow_runs")
}

/// One step of one run. Records the resolved definition versions so a run
/// stays explainable after an agent or skill is edited (CLAUDE.md §2.11).
model WorkflowStepRun {
  id               String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  runId            String        @map("run_id") @db.Uuid
  run              WorkflowRun   @relation(fields: [runId], references: [id], onDelete: Cascade)
  /// Step key from the graph.
  stepKey          String        @map("step_key")
  /// Execution order, 1-based within the run.
  sequence         Int
  kind             String
  status           StepRunStatus @default(PENDING)
  /// Resolved agent and its pinned version number.
  agentId          String?       @map("agent_id") @db.Uuid
  agent            Agent?        @relation("StepRunAgent", fields: [agentId], references: [id], onDelete: SetNull)
  agentVersionId   String?       @map("agent_version_id") @db.Uuid
  agentVersion     AgentVersion? @relation(fields: [agentVersionId], references: [id], onDelete: SetNull)
  agentVersionNumber Int?        @map("agent_version_number")
  skillId          String?       @map("skill_id") @db.Uuid
  skill            Skill?        @relation("StepRunSkill", fields: [skillId], references: [id], onDelete: SetNull)
  skillVersionId   String?       @map("skill_version_id") @db.Uuid
  skillVersion     SkillVersion? @relation(fields: [skillVersionId], references: [id], onDelete: SetNull)
  skillVersionNumber Int?        @map("skill_version_number")
  /// Links to the Phase 3 AI ledger when the step called a model.
  generationId     String?       @map("generation_id") @db.Uuid
  generation       Generation?   @relation(fields: [generationId], references: [id], onDelete: SetNull)
  /// Rendered instruction actually sent, for reproducibility.
  instruction      String?       @db.Text
  output           Json?         @map("output")
  errorMessage     String?       @map("error_message")
  latencyMs        Int?          @map("latency_ms")
  startedAt        DateTime      @default(now()) @map("started_at")
  completedAt      DateTime?     @map("completed_at")
  /// Phase 5: retrievals triggered by or within this step. One-to-many
  /// because a step may retrieve more than once.
  retrievals       RetrievalAudit[] @relation("StepRunRetrieval")

  @@unique([runId, sequence])
  @@unique([runId, stepKey])
  // Every nullable FK here is `SetNull`, so deleting the parent issues an
  // `UPDATE ... WHERE col = $1` against this table. PostgreSQL does not
  // index a referencing column automatically, so without these each such
  // delete seq-scans every step row ever recorded (a workspace delete
  // cascades through agents and skills, hitting exactly this path).
  @@index([agentId])
  @@index([agentVersionId])
  @@index([skillId])
  @@index([skillVersionId])
  @@index([generationId])
  @@map("workflow_step_runs")
}

// ==================== Knowledge / Retrieval (Phase 5) ====================
// Scope: references (external source material), their chunks, embeddings and
// retrieval provenance, per docs/04-data/DATA-MODEL-BLUEPRINT.md
// §Knowledge/RAG and CLAUDE.md §9/§10.
//
// Invariant that shapes every model here (CLAUDE.md §2.2, invariants: "canonical
// relational state is authoritative; embeddings, summaries, caches, LLM memory
// and generated candidate facts are rebuildable projections"): chunks and
// embeddings are PROJECTIONS. Deleting every row in chunks/embeddings loses no
// truth — it regenerates from the reference version. Nothing may treat a chunk
// as authoritative.

/// How much of the story a viewer has read (CLAUDE.md §10). A third mode is
/// what makes reader-facing AI expressible at all; an unrecognised value must
/// fail closed to READER, never open.
enum SpoilerMode {
  /// Sees everything, including drafts and pre-publication notes.
  AUTHOR
  /// Sees everything for continuity review; may read drafts.
  EDITOR
  /// Sees only what is available at the chapter they have reached.
  READER
}

enum ReferenceKind {
  NOTE
  GUIDE
  RESEARCH
  STYLE
  GLOSSARY
  IMPORTED
}

enum ReferenceStatus {
  DRAFT
  /// In the workspace's retrieval scope. Still never canon.
  ACTIVE
  ARCHIVED
}

/// External source material: a writing guide, a research note, an imported
/// document (CLAUDE.md §3 "Reference").
///
/// A reference is NOT canon and does not become canon by ingestion. Nothing in
/// this table is story truth; it is guidance the author chose to consult.
/// Ingestion writes only to these tables (CLAUDE.md §21).
model Reference {
  id               String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Tenant boundary. Always workspace-scoped: material one author imports is
  /// not another tenant's business.
  workspaceId      String            @map("workspace_id") @db.Uuid
  workspace        Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  /// Optional narrowing to one novel, for material specific to it.
  novelId          String?           @map("novel_id") @db.Uuid
  novel            Novel?            @relation(fields: [novelId], references: [id], onDelete: Cascade)
  key              String
  title            String
  kind             ReferenceKind     @default(NOTE)
  /// Where it came from: a URL, a citation, a filename. Provenance for the
  /// author. The server never fetches it, so it is data, not a fetch target.
  source           String?
  status           ReferenceStatus   @default(DRAFT)
  currentVersionId String?           @unique @map("current_version_id") @db.Uuid
  currentVersion   ReferenceVersion? @relation("CurrentReferenceVersion", fields: [currentVersionId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  createdById      String            @map("created_by_id") @db.Uuid
  createdBy        User              @relation("ReferenceCreator", fields: [createdById], references: [id])
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")
  versions         ReferenceVersion[] @relation("ReferenceVersions")

  @@unique([workspaceId, key], name: "reference_workspace_key")
  @@index([workspaceId, status])
  @@index([novelId])
  @@map("references")
}

/// Immutable revision of a reference's text.
///
/// Append-only, matching ChapterVersion (Phase 2) and the Phase 4 definitions.
/// Chunks are keyed to the version they were cut from, so re-ingesting never
/// mixes text from two revisions in one index.
model ReferenceVersion {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  referenceId String    @map("reference_id") @db.Uuid
  reference   Reference @relation("ReferenceVersions", fields: [referenceId], references: [id], onDelete: Cascade)
  number      Int
  content     String    @db.Text
  /// SHA-256 of `content`, so a version's text is addressable and an
  /// identical re-import is detectable without comparing the whole body.
  ///
  /// Nothing READS it today: a version is immutable, so its own hash can
  /// never change, and `ingest` decides what to rebuild from the projection's
  /// state (does this version have chunks, and does each have a vector?)
  /// rather than from a hash comparison. The index stays because the natural
  /// reader is a future dedup path — imported material frequently re-arrives
  /// under a new key — and it is the cheap half of that.
  contentHash String    @map("content_hash")
  charCount   Int       @map("char_count")
  note        String?
  createdById String    @map("created_by_id") @db.Uuid
  createdBy   User      @relation("ReferenceVersionCreator", fields: [createdById], references: [id])
  createdAt   DateTime  @default(now()) @map("created_at")
  chunks      Chunk[]
  /// Opposite side of Reference.currentVersion.
  currentForReference Reference? @relation("CurrentReferenceVersion")
  factSources         CanonFactSource[]

  @@unique([referenceId, number])
  @@index([referenceId, createdAt])
  @@index([contentHash])
  @@map("reference_versions")
}

/// One retrievable unit of a reference version.
///
/// `start`/`end` are character offsets into `referenceVersion.content`, and
/// `text` is exactly `content.slice(start, end)` — enforced by the chunker's
/// verifier before insert. That is what makes a citation resolvable: a result
/// traces back to the exact span of the exact revision, with nothing inferred
/// in between.
model Chunk {
  id                   String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  referenceVersionId   String           @map("reference_version_id") @db.Uuid
  referenceVersion     ReferenceVersion @relation(fields: [referenceVersionId], references: [id], onDelete: Cascade)
  /// Denormalised tenant boundary so a filtered query never joins to enforce
  /// isolation. Ingest asserts it matches the reference's workspace; a
  /// mismatch would be a cross-tenant leak.
  workspaceId          String           @map("workspace_id") @db.Uuid
  index                Int
  text                 String           @db.Text
  start                Int
  end                  Int
  /// Chapter at which this becomes reader-visible (CLAUDE.md §10). null means
  /// not reader-visible at all — the safe default for imported material, which
  /// is the author's reference, not the story.
  availableFromChapter Int?             @map("available_from_chapter")
  /// tsvector for the lexical half of hybrid retrieval. Populated by the
  /// ingest statement from `text` (see the Phase 5 migration), NOT by a
  /// database default — Prisma cannot declare a generated column, and a
  /// column Prisma cannot see would be reported as drift forever. Because
  /// it is written in the same INSERT as `text`, the two cannot disagree.
  /// Unsupported() because the generated client does not model tsvector;
  /// lexical search reaches it through raw SQL.
  contentTs            Unsupported("tsvector")? @map("content_ts")
  createdAt            DateTime         @default(now()) @map("created_at")
  embedding            Embedding?

  @@unique([referenceVersionId, index])
  @@index([workspaceId])
  @@index([availableFromChapter])
  /// GIN over the tsvector: the lexical half of hybrid retrieval. Without it
  /// every `@@` match is a sequential scan of all chunks in the workspace.
  @@index([contentTs], type: Gin)
  @@map("chunks")
}

/// The vector projection of one chunk.
///
/// Separate from Chunk because this is the rebuildable half: re-embedding with
/// a new model writes new rows and never touches the text. `model` records
/// which model produced the vector, so a mixed index is detectable — comparing
/// vectors from two models is meaningless and would degrade ranking silently
/// rather than fail.
model Embedding {
  chunkId    String   @id @map("chunk_id") @db.Uuid
  chunk      Chunk    @relation(fields: [chunkId], references: [id], onDelete: Cascade)
  /// Provider model id. Not a constant: operators change embedding models, and
  /// a stale vector must be distinguishable from a current one.
  model      String
  /// Recorded so a dimension mismatch is diagnosable rather than mysterious.
  dimensions Int
  /// 1536 dims, fixed: pgvector refuses to build an HNSW index on a
  /// dimensionless column (verified against 0.8.6 — "column does not have
  /// dimensions"), and a dimensionless column silently accepts mixed lengths.
  /// A fixed column also rejects a wrong-length vector at insert, loudly.
  vector     Unsupported("vector(1536)") @map("vector")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([model])
  // DELIBERATELY NO VECTOR INDEX HERE.
  //
  // Neither index pgvector offers can be declared: this Prisma version
  // rejects every HNSW spelling (`Hnsw`/`HNSW`/`hnsw`/`HnswOps`) and
  // `IVFFlat`/`IvfFlat`/`ivfflat` alike — all "Unknown index type",
  // verified by substituting each and running `validate`. The community
  // workaround is to hand-write the index into the migration, but that is
  // not neutral: Prisma then reports "Removed index on columns (vector)" as
  // drift on EVERY later `migrate diff`, and the next person to accept a
  // generated migration silently destroys vector search.
  //
  // Phase 5 therefore runs exact nearest-neighbour search — a sequential
  // scan computing cosine distance. That is not a compromise but the more
  // correct answer: no recall loss, no `lists`/`probes` tuning, no reindex
  // after bulk ingest. It is O(rows scanned), which is fine for a reference
  // corpus (guides and research notes, not the manuscript) and becomes the
  // first thing to revisit at scale. See the Phase 5 migration for the
  // upgrade path, which is an explicit operational step rather than
  // something `migrate dev` can undo.
  @@map("embeddings")
}

/// One retrieval operation, recorded so a generation can cite what it read.
///
/// This is the "evidence-bearing" half of the Phase 5 exit criterion: an
/// answer is traceable to the exact chunks put in front of the model, with the
/// mode and reader position that governed the filter. Without this row, "the
/// AI said X" has no audit trail.
model RetrievalAudit {
  id            String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId   String           @map("workspace_id") @db.Uuid
  workspace     Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  novelId       String?          @map("novel_id") @db.Uuid
  novel         Novel?           @relation(fields: [novelId], references: [id], onDelete: Cascade)
  /// The query as issued. Kept because relevance cannot be judged later
  /// without it; never carries credentials.
  query         String
  mode          SpoilerMode
  /// Reader position that governed filtering, when mode is READER.
  readerChapter Int?             @map("reader_chapter")
  /// Results after spoiler filtering, and how many the boundary withheld. The
  /// difference is the number an operator needs when a reader reports missing
  /// content.
  returnedCount Int              @map("returned_count")
  withheldCount Int              @map("withheld_count")
  /// Per-result provenance: chunk id, reference version, each retriever's
  /// rank, and the final fused score.
  results       Json             @default("[]")
  /// Which legs actually ran — a degraded search (vector leg down) must be
  /// distinguishable from a complete one.
  retrievers    String[]         @default([])
  latencyMs     Int?             @map("latency_ms")
  /// Set when the caller was a workflow step, so a run's retrieval is
  /// reachable from the run as well as from the generation.
  ///
  /// Deliberately NOT unique: a step may retrieve more than once (a
  /// multi-query retrieval, or a retry after a gateway blip), and a unique
  /// constraint would turn that into a 500 mid-run rather than a second
  /// audit row.
  stepRunId     String?          @map("step_run_id") @db.Uuid
  stepRun       WorkflowStepRun? @relation("StepRunRetrieval", fields: [stepRunId], references: [id], onDelete: SetNull)
  generationId  String?          @map("generation_id") @db.Uuid
  generation    Generation?      @relation("GenerationRetrieval", fields: [generationId], references: [id], onDelete: SetNull)
  createdAt     DateTime         @default(now()) @map("created_at")

  @@index([workspaceId, createdAt])
  @@index([novelId, createdAt])
  @@index([stepRunId])
  @@index([generationId])
  @@map("retrieval_audits")
}

// ==================== Story Intelligence (Phase 6) ====================
// Canon is the source of story truth (CLAUDE.md section 2.1): canon_facts and
// canon_fact_sources are authoritative. Everything derived from them —
// summaries, embeddings, hierarchical memory — is a rebuildable projection
// (section 2.2), which is why no summary table is created here.
//
// story_entities is the naming layer that gives canon a SUBJECT. It is not
// canon: an entity row asserts only that the story names a thing, so creating
// one commits no story truth and needs no approval (section 2.13 constrains
// canon commits, not naming).
//
// NOT in this phase (their own phases own them — do not add early):
//   synopses/sagas/arcs/outline_nodes                      -> Phase 7
//   characters/character_states/relationship graph          -> Phase 8
//   settlements/economy/politics/technology                 -> Phase 10
//   revisions/change_sets/snapshots/checkpoints/branches     -> Phase 11
//   ending_visions/resolution_items/callback_candidates      -> Phase 12
// Accepted consequence: canon facts carry NO revision_id until Phase 11, so
// "canon is never destructively overwritten" (section 2.11) is met here by
// CanonFactStatus plus the supersede chain. See ADR-0008.

/// What kind of thing a story entity names. Deliberately coarse: this is an
/// identity layer, not a detail model. A world rule is a CanonFact on a
/// CONCEPT entity; structured location/faction/economy detail belongs to its
/// own phase and would be a separate table.
enum StoryEntityKind {
  CHARACTER
  LOCATION
  ORGANIZATION
  FACTION
  ITEM
  RESOURCE
  CONCEPT
}

/// Liveness of a canon fact. ACTIVE is the single live state (ADR-0008 §1);
/// there is no separate pointer-based liveness predicate. RETRACTED means the
/// author withdrew the claim — it frees the live slot, so the same claim can
/// be re-asserted later.
enum CanonFactStatus {
  ACTIVE
  SUPERSEDED
  RETRACTED
}

enum CanonProposalStatus {
  PROPOSED
  APPROVED
  REJECTED
  SUPERSEDED
}

/// How a proposal relates to what is already canon.
///
/// CONFLICT is deliberately NOT a CanonProposalStatus: as a status value the
/// approval gate would be a forgettable code path, whereas a nullable flag is
/// structural — "only a NEW claim may be auto-approved" becomes a property of
/// the row rather than a rule someone must remember.
enum ConflictKind {
  FUNCTIONAL_CONFLICT
}

/// Where a source's evidence came from. Drives which span columns are
/// populated; a CHECK in the migration requires exactly one form.
enum SourceKind {
  CHAPTER
  REFERENCE
}

/// A named thing in the story: the subject canon talks about.
///
/// `key` is the stable machine identity (unique per novel) and is what
/// canonicalSubjectKey() produces; `name` is display only. Aliases are
/// deliberately NOT modelled here (ADR-0008 §5): an exact-match alias array
/// cannot resolve a typo, so the alias structure waits for real data rather
/// than guessing at a shape now.
model StoryEntity {
  id          String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  novelId     String          @map("novel_id") @db.Uuid
  novel       Novel           @relation(fields: [novelId], references: [id], onDelete: Cascade)
  kind        StoryEntityKind
  /// Stable machine key, unique within the novel (lowercase kebab).
  key         String
  name        String
  createdById String          @map("created_by_id") @db.Uuid
  createdBy   User            @relation("StoryEntityCreator", fields: [createdById], references: [id])
  createdAt   DateTime        @default(now()) @map("created_at")
  facts       CanonFact[]     @relation("CanonFactSubject")
  objectOf    CanonFact[]     @relation("CanonFactObjectEntity")
  proposals   CanonProposal[]
  proposedObjectOf CanonProposal[] @relation("CanonProposalObjectEntity")

  @@unique([novelId, key])
  @@index([novelId, kind])
  @@map("story_entities")
}

/// One approved claim about the story: (entity, predicate, object).
///
/// APPEND-ONLY. A correction supersedes; it never edits. The supersede chain
/// (supersededById) IS the version history — there is no separate version
/// table, because a fact's content is never mutated (ADR-0008 §2).
///
/// Exactly one of objectEntityId / objectText is set, enforced by CHECK. An
/// entity-valued object ("A is B's father") gets a real FK; a literal object
/// ("A's hair is black") gets text.
///
/// Live uniqueness — at most one ACTIVE row per (novel, entity, predicate) —
/// is a PARTIAL UNIQUE INDEX created in the Phase 6 migration, NOT an
/// @@unique here: Prisma cannot declare a partial index without a preview
/// flag, and the constraint must be anchored on status so RETRACTED frees the
/// slot (ADR-0008 §1). Do NOT "fix" this by adding an @@unique to the model —
/// a key containing the object value would stop detecting contradictions
/// entirely, which is the one thing this constraint exists to catch.
model CanonFact {
  id                   String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Denormalised tenant boundary, matching Chunk (ADR-0007): a filtered
  /// query never joins to enforce isolation.
  workspaceId          String          @map("workspace_id") @db.Uuid
  workspace            Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  novelId              String          @map("novel_id") @db.Uuid
  /// RESTRICT, not Cascade: the entity-level RESTRICTs below are satisfied
  /// trivially when the facts are removed by their OWN novel cascade before
  /// the entity cascade fires — so at novel-delete scope those rules would
  /// not protect the canon record (verified against Postgres trigger order).
  /// A novel carrying facts must refuse deletion, exactly like deleteEntity.
  novel                Novel           @relation(fields: [novelId], references: [id], onDelete: Restrict)
  entityId             String          @map("entity_id") @db.Uuid
  /// RESTRICT, not Cascade: a fact is the canon record (CLAUDE.md §2.11) and
  /// must not vanish because its subject row was deleted. deleteEntity maps
  /// the refusal to a 409 naming the blocking facts. objectEntityId cannot be
  /// SET NULL — both object columns NULL violates CanonFact_object_exactly_one.
  entity               StoryEntity     @relation("CanonFactSubject", fields: [entityId], references: [id], onDelete: Restrict)
  predicate            String
  /// Entity-valued object (a relationship). Null when the object is text.
  objectEntityId       String?         @map("object_entity_id") @db.Uuid
  /// RESTRICT for the same reason: the fact survives its object too.
  objectEntity         StoryEntity?    @relation("CanonFactObjectEntity", fields: [objectEntityId], references: [id], onDelete: Restrict)
  /// Literal object. Null when the object is an entity.
  objectText           String?         @map("object_text")
  /// Human-readable rendering of the claim, for display. The structured
  /// columns remain authoritative; this must never be parsed back into them.
  statement            String
  status               CanonFactStatus @default(ACTIVE)
  /// In-story validity window. Distinct from the spoiler axis below: a fact
  /// can be true in-story from ch 5 but revealed to readers at ch 400.
  validFromChapter     Int?            @map("valid_from_chapter")
  validUntilChapter    Int?            @map("valid_until_chapter")
  /// Chapter at which this becomes reader-visible (CLAUDE.md section 10). The
  /// identical column and null-means-not-visible semantics as
  /// Chunk.availableFromChapter, so one predicate governs both.
  availableFromChapter Int?            @map("available_from_chapter")
  /// The fact that replaced this one. Set once, on supersede; this is the
  /// whole version history. SET NULL because deleting a successor must not
  /// cascade-delete the fact it replaced.
  supersededById       String?         @map("superseded_by_id") @db.Uuid
  supersededBy         CanonFact?      @relation("CanonFactSupersede", fields: [supersededById], references: [id], onDelete: SetNull)
  supersededFrom       CanonFact[]     @relation("CanonFactSupersede")
  createdById          String          @map("created_by_id") @db.Uuid
  createdBy            User            @relation("CanonFactCreator", fields: [createdById], references: [id])
  createdAt            DateTime        @default(now()) @map("created_at")
  sources              CanonFactSource[]
  conflictsWith        CanonProposal[] @relation("CanonProposalConflict")
  approvedProposal     CanonProposal?  @relation("CanonProposalFact")
  knownBy              CharacterKnowledge[] @relation("KnowledgeOfFact")

  @@index([novelId, entityId, predicate])
  @@index([entityId])
  @@index([novelId, status])
  @@index([novelId, validFromChapter])
  @@index([availableFromChapter])
  // Self-FK target of the supersede chain: without this, deleting a fact
  // seq-scans every canon fact to resolve the SetNull.
  @@index([supersededById])
  @@index([objectEntityId])
  @@map("canon_facts")
}

/// Evidence for one canon fact: the exact span of the exact revision the
/// claim came from.
///
/// Follows the Chunk discipline (ADR-0007): `quote` is exactly
/// `source.slice(start, end)` against an IMMUTABLE version, verified by the
/// writer before insert. That is what makes a citation resolvable — nothing
/// is inferred in between.
///
/// Deliberately NO chunk_id: re-ingesting a reference DELETEs and re-inserts
/// its chunks with fresh uuids, so a chunk citation dangles after an
/// unrelated re-ingest. (referenceVersionId, start, end) is the stable
/// identity, which is exactly what the reference legs already verify.
///
/// Deliberately NO generation_id: nothing in this phase can populate it. Add
/// it with the extraction pipeline that produces those generations.
model CanonFactSource {
  id                 String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  canonFactId        String            @map("canon_fact_id") @db.Uuid
  canonFact          CanonFact         @relation(fields: [canonFactId], references: [id], onDelete: Cascade)
  sourceKind         SourceKind        @map("source_kind")
  /// The exact immutable chapter revision. Stays resolvable forever, but it
  /// is a HISTORICAL pin: Chapter.currentVersion moves on the next save, so a
  /// source is not "the current version" by definition.
  chapterVersionId   String?           @map("chapter_version_id") @db.Uuid
  /// RESTRICT: a citation is the only place the fact's span is stored, so
  /// cascading it away would leave an ACTIVE fact claiming support it can no
  /// longer show. deleteChapter hard-deletes non-PUBLISHED chapters, so
  /// CASCADE let a routine draft deletion strip canon evidence silently.
  chapterVersion     ChapterVersion?   @relation(fields: [chapterVersionId], references: [id], onDelete: Restrict)
  /// The exact immutable reference revision.
  referenceVersionId String?           @map("reference_version_id") @db.Uuid
  referenceVersion   ReferenceVersion? @relation(fields: [referenceVersionId], references: [id], onDelete: Restrict)
  quote              String            @db.Text
  start              Int
  end                Int
  createdById        String            @map("created_by_id") @db.Uuid
  createdBy          User              @relation("CanonFactSourceCreator", fields: [createdById], references: [id])
  createdAt          DateTime          @default(now()) @map("created_at")

  @@index([canonFactId])
  // Every nullable FK gets its own index: the referencing side is still
  // scanned when the parent row is deleted, whatever the delete rule. Both
  // source FKs are RESTRICT, not Cascade — a draft chapter deletion must not
  // silently strip a live fact's citation (round 4, ADR-0008).
  @@index([chapterVersionId])
  @@index([referenceVersionId])
  @@map("canon_fact_sources")
}

/// A claim under review. Becomes canon only through an explicit
/// canon:approve decision (CLAUDE.md section 2.13) — there is no silent
/// commit, from any code path.
///
/// claim_kind is deliberately ABSENT: basis is a property of the evidence
/// (CLAUDE.md section 21). A proposer-authored ESTABLISHED label would let
/// whoever writes the row satisfy the very gate it is meant to pass.
model CanonProposal {
  id                  String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Denormalised tenant boundary, as on CanonFact.
  workspaceId         String              @map("workspace_id") @db.Uuid
  workspace           Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  novelId             String              @map("novel_id") @db.Uuid
  novel               Novel               @relation(fields: [novelId], references: [id], onDelete: Cascade)
  entityId            String              @map("entity_id") @db.Uuid
  entity              StoryEntity         @relation(fields: [entityId], references: [id], onDelete: Cascade)
  predicate           String
  objectEntityId      String?             @map("object_entity_id") @db.Uuid
  objectEntity        StoryEntity?        @relation("CanonProposalObjectEntity", fields: [objectEntityId], references: [id], onDelete: Cascade)
  objectText          String?             @map("object_text")
  statement           String
  /// When the proposed claim becomes true in-story. Carried onto the fact at
  /// approval, and used to CLOSE the superseded fact's window — without it a
  /// correction would be undatable and an as-of query could not tell which
  /// value held when.
  validFromChapter    Int?                @map("valid_from_chapter")
  status              CanonProposalStatus @default(PROPOSED)
  /// How this claim relates to existing canon. Null means NEW — and only a
  /// NEW claim is ever eligible for auto-approval.
  conflictKind        ConflictKind?       @map("conflict_kind")
  conflictsWithFactId String?             @map("conflicts_with_fact_id") @db.Uuid
  conflictsWithFact   CanonFact?          @relation("CanonProposalConflict", fields: [conflictsWithFactId], references: [id], onDelete: SetNull)
  /// The fact minted by approval. @unique makes approval idempotent: a second
  /// approve cannot mint a second fact.
  canonFactId         String?             @unique @map("canon_fact_id") @db.Uuid
  canonFact           CanonFact?          @relation("CanonProposalFact", fields: [canonFactId], references: [id], onDelete: SetNull)
  proposedById        String?             @map("proposed_by_id") @db.Uuid
  proposedBy          User?               @relation("CanonProposalAuthor", fields: [proposedById], references: [id], onDelete: SetNull)
  decidedById         String?             @map("decided_by_id") @db.Uuid
  decidedBy           User?               @relation("CanonProposalDecider", fields: [decidedById], references: [id], onDelete: SetNull)
  decidedAt           DateTime?           @map("decided_at")
  decisionNote        String?             @map("decision_note")
  createdAt           DateTime            @default(now()) @map("created_at")
  updatedAt           DateTime            @updatedAt @map("updated_at")

  @@index([workspaceId, status])
  @@index([novelId, status])
  @@index([entityId])
  @@index([objectEntityId])
  @@index([conflictsWithFactId])
  @@index([proposedById])
  @@index([decidedById])
  @@map("canon_proposals")
}

// ==================== Planning (Phase 7, slice 1) ====================
// Scope: the planning spine per docs/04-data/DATA-MODEL-BLUEPRINT.md
// §Planning. Hierarchy: Novel Vision > Saga > Major Arc > Mini Arc >
// Chapter Group > Chapter > Scene. The Saga/Arc tables self-nest through
// parentId; outline_nodes are the leaf graph that references their planning
// parent plus an optional chapter/scene. CLAUDE.md §4: the current APPROVED
// outline outranks the synopsis for chapter-level planning — so the approved
// outline version is unique per novel (partial index in the migration, like
// canon_facts_live), and synopses carry no such uniqueness.

enum SynopsisStatus {
  ACTIVE
  ARCHIVED
}

model Synopsis {
  id          String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  novelId     String         @map("novel_id") @db.Uuid
  novel       Novel          @relation(fields: [novelId], references: [id], onDelete: Cascade)
  /// High-level direction, not a chapter script (CLAUDE.md §2.3). Stored as
  /// one bullet per line so plannerContext can diff bullets against the
  /// approved outline; parsing stays in packages/planning, not in the schema.
  content     String         @db.Text
  status      SynopsisStatus @default(ACTIVE)
  createdById String         @map("created_by_id") @db.Uuid
  createdBy   User           @relation("SynopsisCreator", fields: [createdById], references: [id])
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  @@index([novelId, status])
  @@map("synopses")
}

enum PlanningKind {
  SAGA
  ARC
  CHAPTER_GROUP
}

/// Shared shape of the self-nesting containers between Vision and Chapter:
/// a Saga, a Major Arc, or a Mini Arc / Chapter Group. The `kind` column
/// records which; nesting depth is validated by packages/planning, not
/// trusted to the author UI. A chapter row itself lives in `chapters` —
/// it hangs off an outline_node, not off this table.
model Saga {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  novelId     String       @map("novel_id") @db.Uuid
  novel       Novel        @relation(fields: [novelId], references: [id], onDelete: Cascade)
  parentId    String?      @map("parent_id") @db.Uuid
  parent      Saga?        @relation("SagaNest", fields: [parentId], references: [id], onDelete: Cascade)
  children    Saga[]       @relation("SagaNest")
  kind        PlanningKind
  title       String
  /// Intent for this container (what it must accomplish). Direction, not
  /// script — the outline versions hold the chapter-level plan.
  intent      String?      @db.Text
  createdById String       @map("created_by_id") @db.Uuid
  createdBy   User         @relation("SagaCreator", fields: [createdById], references: [id])
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")
  outlineNodes OutlineNode[]

  @@index([novelId, kind])
  @@index([parentId])
  @@map("sagas")
}

enum OutlineNodeKind {
  CHAPTER_GROUP
  CHAPTER
  SCENE
}

/// One node of the approved outline graph. Node nests under a Saga (which
/// covers saga/major-arc/mini-arc/chapter-group levels via Saga.kind) and —
/// at the leaf — points at the actual Chapter or Scene row it plans.
/// `order` is position among siblings (unique per parent, like Chapter.number).
model OutlineNode {
  id           String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  novelId      String          @map("novel_id") @db.Uuid
  novel        Novel           @relation(fields: [novelId], references: [id], onDelete: Cascade)
  sagaId       String          @map("saga_id") @db.Uuid
  saga         Saga            @relation(fields: [sagaId], references: [id], onDelete: Cascade)
  kind         OutlineNodeKind
  title        String
  /// Beats/summary for this node. Direction, not prose.
  summary      String?         @db.Text
  order        Int
  /// Leaf links. Null for CHAPTER_GROUP nodes; exactly one is set when kind
  /// is CHAPTER/SCENE — enforced by a CHECK in the migration.
  chapterId    String?         @map("chapter_id") @db.Uuid
  chapter      Chapter?        @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  sceneId      String?         @map("scene_id") @db.Uuid
  scene        Scene?          @relation(fields: [sceneId], references: [id], onDelete: Cascade)
  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")

  @@unique([sagaId, order])
  @@index([novelId])
  @@index([chapterId])
  @@index([sceneId])
  @@map("outline_nodes")
}

enum OutlineVersionStatus {
  DRAFT
  APPROVED
  SUPERSEDED
}

/// Append-only snapshot of the full outline (nodes + their order/links) as
/// one versioned document. Rows are never mutated: superseding creates a new
/// row and flips the old one to SUPERSEDED via the approval flow. At most one
/// APPROVED version per novel — partial unique index "outline_versions_live"
/// in migration 20261001_phase7_planning, on the canon_facts_live pattern.
model OutlineVersion {
  id          String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  novelId     String              @map("novel_id") @db.Uuid
  novel       Novel               @relation(fields: [novelId], references: [id], onDelete: Cascade)
  /// Monotonic per novel, enforced by (novelId, number) unique.
  number      Int
  status      OutlineVersionStatus @default(DRAFT)
  /// The full node list of this version. JSONB on purpose: an outline
  /// version is a frozen document read/written as a unit; structured
  /// per-node truth lives in outline_nodes.
  content     Json
  note        String?
  createdById String              @map("created_by_id") @db.Uuid
  createdBy   User                @relation("OutlineVersionCreator", fields: [createdById], references: [id])
  createdAt   DateTime            @default(now()) @map("created_at")

  @@unique([novelId, number])
  @@index([novelId, status])
  @@map("outline_versions")
}

/// Per-novel Planning Horizon policy: detail level by narrative distance
/// (CLAUDE.md §2.8). NOT universal constants — each novel carries its own
/// JSONB policy (bands of distance -> detail), interpreted by
/// horizonFor() in packages/planning.
model PlanningHorizon {
  novelId   String   @id @map("novel_id") @db.Uuid
  novel     Novel    @relation(fields: [novelId], references: [id], onDelete: Cascade)
  /// { bands: [{ maxDistance: number, detail: string }...] }, ascending;
  /// shape validated by horizonFor, not trusted.
  policy    Json
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("planning_horizons")
}

// Phase 6 slice 2 — story events, timeline, threads, promises, causal graph
// (DATA-MODEL-BLUEPRINT.md slice 2). Vocabulary below is pinned by
// packages/story-intelligence events.test.ts — changing a member there
// without the enum (or the reverse) must fail a test.

enum ThreadKind {
  MYSTERY
  CONFLICT
  QUESTION
  OBJECTIVE
  SUBPLOT
}

enum ThreadStatus {
  ACTIVE
  DORMANT
  RESOLVED
}

enum PromiseStatus {
  SETUP
  DEVELOPING
  READY_FOR_PAYOFF
  PAID_OFF
  ABANDONED
  INVALIDATED
}

enum CausalConfidence {
  EXPLICIT
  INFERRED
  SPECULATIVE
}

/// An event that happened in the story. Structured fact, not prose — prose
/// lives in chapters; this is the record the causal graph and Story Brain
/// reason over. AI-extracted events are candidate canon (CLAUDE.md §2.2,
/// §2.13) until approved like any other canon mutation.
model StoryEvent {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Denormalised tenant boundary, matching Chunk (ADR-0007): a filtered
  /// query never joins to enforce isolation.
  workspaceId String    @map("workspace_id") @db.Uuid
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  novelId     String    @map("novel_id") @db.Uuid
  novel       Novel     @relation(fields: [novelId], references: [id], onDelete: Cascade)
  /// What happened, stated as a fact.
  description String    @db.Text
  /// Chapter whose prose established this event. RESTRICT, matching
  /// CanonFactSource citations: deleting the prose that established canon
  /// must not silently orphan the record.
  chapterId   String?   @map("chapter_id") @db.Uuid
  chapter     Chapter?  @relation(fields: [chapterId], references: [id], onDelete: Restrict)
  /// Chapter at which this becomes reader-visible (CLAUDE.md section 10). The
  /// identical column and null-means-not-visible semantics as
  /// Chunk.availableFromChapter, so one predicate governs both.
  availableFromChapter Int? @map("available_from_chapter")
  createdById String    @map("created_by_id") @db.Uuid
  createdBy   User      @relation("StoryEventCreator", fields: [createdById], references: [id])
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  causedEdges CausalEdge[]       @relation("CausalEdgeCause")
  effectsFrom CausalEdge[]       @relation("CausalEdgeEffect")
  threadLinks StoryThreadEvent[]

  @@index([novelId])
  @@index([chapterId])
  @@index([availableFromChapter])
  @@map("story_events")
}

/// In-story chronological position of an event. `order` is the timeline
/// slot; the per-novel unique pair is the write-side enforcement of the
/// strict ordering isChronological() checks on read — ties assert an order
/// the data cannot support.
model TimelineEvent {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Denormalised tenant boundary, matching Chunk (ADR-0007): a filtered
  /// query never joins to enforce isolation.
  workspaceId String    @map("workspace_id") @db.Uuid
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  novelId     String    @map("novel_id") @db.Uuid
  novel       Novel     @relation(fields: [novelId], references: [id], onDelete: Cascade)
  /// What the timeline says happened, in-story time.
  description String    @db.Text
  /// Timeline slot, unique per novel (ties refuse via isChronological on
  /// read; the unique index refuses them on write).
  order       Int
  /// Chapter at which this becomes reader-visible (CLAUDE.md section 10). The
  /// identical column and null-means-not-visible semantics as
  /// Chunk.availableFromChapter, so one predicate governs both.
  availableFromChapter Int? @map("available_from_chapter")
  createdById String    @map("created_by_id") @db.Uuid
  createdBy   User      @relation("TimelineEventCreator", fields: [createdById], references: [id])
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@unique([novelId, order])
  @@map("timeline_events")
}

/// An open narrative thread — mystery, conflict, question, objective or
/// subplot (STORY-INTELLIGENCE.md). Importance is a debt INPUT; the debt
/// score itself is derived by narrativeDebt(), never stored.
model StoryThread {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Denormalised tenant boundary, matching Chunk (ADR-0007): a filtered
  /// query never joins to enforce isolation.
  workspaceId String       @map("workspace_id") @db.Uuid
  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  novelId     String       @map("novel_id") @db.Uuid
  novel       Novel        @relation(fields: [novelId], references: [id], onDelete: Cascade)
  kind        ThreadKind
  title       String
  /// What the thread is about and where it should go. Direction, not script.
  description String?      @db.Text
  status      ThreadStatus @default(ACTIVE)
  /// Debt input, 1..5 (CHECK in the migration). Not a score.
  importance  Int
  /// Chapter where the thread was introduced. Doubles as the reader
  /// anchor: readers at or past this chapter can see the thread exists.
  introducedAtChapter Int? @map("introduced_at_chapter")
  /// Chapter where the thread resolved. Null while open; set exactly when
  /// status is RESOLVED (CHECK in the migration).
  resolvedAtChapter Int?   @map("resolved_at_chapter")
  /// Planned payoff direction (STORY-INTELLIGENCE.md). Soft guidance.
  payoffIntent String?     @map("payoff_intent") @db.Text
  createdById String       @map("created_by_id") @db.Uuid
  createdBy   User         @relation("StoryThreadCreator", fields: [createdById], references: [id])
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  threadEvents StoryThreadEvent[]

  @@index([novelId, status])
  @@index([novelId, kind])
  @@map("story_threads")
}

/// Evidence link: a story event that develops, serves or pays off a thread.
/// Debt reads these to distinguish a starving thread from a served one.
model StoryThreadEvent {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  threadId    String       @map("thread_id") @db.Uuid
  thread      StoryThread  @relation(fields: [threadId], references: [id], onDelete: Cascade)
  eventId     String       @map("event_id") @db.Uuid
  event       StoryEvent   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  createdById String       @map("created_by_id") @db.Uuid
  createdBy   User         @relation("StoryThreadEventCreator", fields: [createdById], references: [id])
  createdAt   DateTime     @default(now()) @map("created_at")

  @@unique([threadId, eventId])
  @@index([eventId])
  @@map("story_thread_events")
}

/// A promise made to the reader (STORY-INTELLIGENCE.md): SETUP → DEVELOPING
/// → READY_FOR_PAYOFF → PAID_OFF, with ABANDONED/INVALIDATED exits.
/// Forward-only — canPromiseTransition() is the domain rule; the CHECKs pin
/// the reader-facing invariants on write.
model StoryPromise {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Denormalised tenant boundary, matching Chunk (ADR-0007): a filtered
  /// query never joins to enforce isolation.
  workspaceId String        @map("workspace_id") @db.Uuid
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  novelId     String        @map("novel_id") @db.Uuid
  novel       Novel         @relation(fields: [novelId], references: [id], onDelete: Cascade)
  title       String
  /// What the promise is and what paying it off looks like.
  description String?       @db.Text
  status      PromiseStatus @default(SETUP)
  /// Debt input, 1..5 (CHECK in the migration). Not a score.
  importance  Int
  /// Chapter where the promise was set up. Doubles as the reader anchor.
  introducedAtChapter Int?  @map("introduced_at_chapter")
  /// Chapter where the promise was paid off. Null until PAID_OFF (CHECK
  /// in the migration).
  payoffAtChapter Int?      @map("payoff_at_chapter")
  /// Planned payoff direction. Soft guidance.
  payoffIntent String?      @map("payoff_intent") @db.Text
  createdById String        @map("created_by_id") @db.Uuid
  createdBy   User          @relation("StoryPromiseCreator", fields: [createdById], references: [id])
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  @@index([novelId, status])
  @@map("story_promises")
}

/// Cause → effect between story events (STORY-INTELLIGENCE.md). EXPLICIT
/// edges are grounded in prose; INFERRED and SPECULATIVE are AI-derived
/// candidates (CLAUDE.md §2.13) and must carry an approving author
/// (edgeRequiresApproval; CHECK in the migration). Rows are immutable —
/// correct an edge by replacing it, not editing it.
model CausalEdge {
  id           String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Denormalised tenant boundary, matching Chunk (ADR-0007): a filtered
  /// query never joins to enforce isolation.
  workspaceId  String           @map("workspace_id") @db.Uuid
  workspace    Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  novelId      String           @map("novel_id") @db.Uuid
  novel        Novel            @relation(fields: [novelId], references: [id], onDelete: Cascade)
  causeEventId String           @map("cause_event_id") @db.Uuid
  causeEvent   StoryEvent       @relation("CausalEdgeCause", fields: [causeEventId], references: [id], onDelete: Cascade)
  effectEventId String          @map("effect_event_id") @db.Uuid
  effectEvent  StoryEvent       @relation("CausalEdgeEffect", fields: [effectEventId], references: [id], onDelete: Cascade)
  confidence   CausalConfidence
  /// Author who approved this edge. Required for INFERRED/SPECULATIVE, null
  /// for EXPLICIT (CHECK in the migration). RESTRICT: deleting an approver
  /// must not silently un-approve an AI-derived edge.
  approvedById String?          @map("approved_by_id") @db.Uuid
  approvedBy   User?            @relation("CausalEdgeApprover", fields: [approvedById], references: [id], onDelete: Restrict)
  createdAt    DateTime         @default(now()) @map("created_at")

  @@unique([novelId, causeEventId, effectEventId])
  @@index([effectEventId])
  @@map("causal_edges")
}

// ============ Character & Relationship Intelligence (Phase 8) ============
// Scope: the roadmap gates Phase 8 on two validation scenarios
// (monogamy/harem/polygamy and enemy-to-ally) and the MVP cut line says
// "basic character state". The tables below are exactly what
// packages/character-intelligence and packages/relationship-intelligence
// validate — nothing more. Deferred, deliberately (docs/implementation/
// decisions.md): character_state_events, character_beliefs,
// relationship_events, relationship_groups, relationship_group_members,
// relationship_agreements, relationship_arcs, and structured reputation /
// possessions / development-milestone columns. Each earns a table when a
// consumer asks for one.
//
// Vocabulary below is pinned by packages/character-intelligence
// character.test.ts and packages/relationship-intelligence
// relationship.test.ts — changing a member there without the enum (or the
// reverse) must fail a test.
//
// Overlap refusal is enforced by the DATABASE, not only by the domain
// validator: the EXCLUDE constraints (btree_gist, migration
// 20261003_phase8_character_relationship) make two windows claiming the
// same chapter impossible to insert. A validator a route forgets to call
// leaves the invariant true; the reverse is not the case.

enum KnowledgeStance {
  KNOWN
  SUSPECTED
  BELIEVED_FALSE
  UNKNOWN
}

enum KnowledgeSource {
  REMEMBERED
  DERIVED
  LEARNED_IN_WORLD
  EXPERIMENTED
  TAUGHT
  RESEARCHED
}

enum ArcStatus {
  ACTIVE
  RESOLVED
  ABANDONED
}

/// "Kind" suffix only because the model below owns the name
/// RelationshipStance — Prisma keeps models and enums in one namespace.
/// The vocabulary is unchanged.
enum RelationshipStanceKind {
  ALLY
  FRIENDLY
  NEUTRAL
  WARY
  HOSTILE
  ENEMY
}

enum BondStructure {
  MONOGAMY
  POLYGAMY
  POLYAMORY
  HAREM
  REVERSE_HAREM
  POLITICAL_MARRIAGE
  CUSTOM
}

enum BondStage {
  ATTRACTION
  COURTSHIP
  COMMITMENT
  MARRIAGE
  LEGACY
}

enum BondTransitionKind {
  ADVANCE
  REGRESS
  SEVER
}

/// A person in the story — the *agent* of it, as distinct from a
/// StoryEntity, which is a thing canon makes claims about. Standalone
/// rather than a StoryEntity of kind CHARACTER: nothing in Phase 8 reads
/// an entity link, and requiring every character to be a canon subject
/// would force a row the author never asked for. A link can be added when
/// a consumer needs canon claims *about a character* (ADR-0008 §5's
/// posture: wait for real data rather than guess a shape).
model Character {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Denormalised tenant boundary, matching CanonFact and Phase 6 slice 2
  /// (ADR-0007): a filtered query never joins to enforce isolation.
  workspaceId String    @map("workspace_id") @db.Uuid
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  novelId     String    @map("novel_id") @db.Uuid
  novel       Novel     @relation(fields: [novelId], references: [id], onDelete: Cascade)
  /// Stable machine key, unique within the novel (lowercase kebab), the
  /// same contract as StoryEntity.key.
  key         String
  name        String
  summary     String?   @db.Text
  createdById String    @map("created_by_id") @db.Uuid
  createdBy   User      @relation("CharacterCreator", fields: [createdById], references: [id])
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  states          CharacterState[]
  knowledge       CharacterKnowledge[]
  arcs            CharacterArc[]
  stancesFrom     RelationshipStance[] @relation("StanceFrom")
  stancesTo       RelationshipStance[] @relation("StanceTo")
  bondMemberships BondMember[]
  antagonists     Antagonist[]

  @@unique([novelId, key])
  @@map("characters")
}

/// One span of a character's state. Half-open `[from, to)` — the chapter a
/// state changes on belongs to the new state, matching a canon fact's
/// validity window. Overlap is refused by the `character_states_no_overlap`
/// EXCLUDE constraint, not only by validateStateHistory.
model CharacterState {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  characterId String    @map("character_id") @db.Uuid
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  /// Inclusive first chapter the state holds.
  fromChapter Int       @map("from_chapter")
  /// Exclusive last chapter; null = still current.
  toChapter   Int?      @map("to_chapter")
  /// Free-text snapshot. Structured per-dimension columns (location, goals,
  /// condition, ...) wait for a consumer that queries them by dimension;
  /// no locations table exists yet either (Phase 10 owns settlements).
  summary     String    @db.Text
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([characterId])
  @@map("character_states")
}

/// What one character holds about one canon fact, over a chapter window.
/// The knowledge boundary the spec's dialogue/planning validators read
/// (CHARACTER-RELATIONSHIP.md). An explicit UNKNOWN row records that the
/// author checked — which is exactly when a validator must not read
/// absence as permission.
model CharacterKnowledge {
  id          String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  characterId String          @map("character_id") @db.Uuid
  character   Character       @relation(fields: [characterId], references: [id], onDelete: Cascade)
  /// RESTRICT: canon facts are append-only (ADR-0008 §2) and a correction
  /// supersedes rather than deletes, so this costs nothing — and it stops a
  /// future delete path from silently orphaning a belief.
  factId      String          @map("fact_id") @db.Uuid
  fact        CanonFact       @relation("KnowledgeOfFact", fields: [factId], references: [id], onDelete: Restrict)
  stance      KnowledgeStance
  source      KnowledgeSource
  fromChapter Int             @map("from_chapter")
  toChapter   Int?            @map("to_chapter")
  createdAt   DateTime        @default(now()) @map("created_at")

  @@index([characterId])
  @@index([factId])
  @@map("character_knowledge")
}

/// A character's development arc. RESOLVED-with-no-milestone is refused by
/// validateArc, not by a CHECK: it is a cross-row condition.
model CharacterArc {
  id          String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  characterId String                  @map("character_id") @db.Uuid
  character   Character               @relation(fields: [characterId], references: [id], onDelete: Cascade)
  status      ArcStatus               @default(ACTIVE)
  title       String
  createdAt   DateTime                @default(now()) @map("created_at")
  updatedAt   DateTime                @updatedAt @map("updated_at")
  milestones  CharacterArcMilestone[]

  @@index([characterId])
  @@map("character_arcs")
}

/// Milestones must be strictly increasing in chapter — two on one chapter
/// are one beat written twice, and an arc whose order is ambiguous cannot
/// answer "where is this character now". The unique index pins the
/// same-chapter half; the ordering half is validateArc's.
model CharacterArcMilestone {
  id        String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  arcId     String       @map("arc_id") @db.Uuid
  arc       CharacterArc @relation(fields: [arcId], references: [id], onDelete: Cascade)
  chapter   Int
  summary   String       @db.Text
  createdAt DateTime     @default(now()) @map("created_at")

  @@unique([arcId, chapter])
  @@map("character_arc_milestones")
}

/// One span of how `fromCharacter` regards `toCharacter`.
///
/// Directional and deliberately not mirrored: a one-sided feud needs
/// A→B ENEMY while B→A stays FRIENDLY. The enemy-to-ally turn is two spans,
/// not an overwrite — the earlier stance is history, not a mistake.
/// `character_stances_no_overlap` EXCLUDE refuses a second span for the
/// same directed pair in the same chapter; from ≠ to is a CHECK.
model RelationshipStance {
  id              String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Denormalised tenant boundary (ADR-0007).
  workspaceId     String                 @map("workspace_id") @db.Uuid
  workspace       Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  fromCharacterId String                 @map("from_character_id") @db.Uuid
  fromCharacter   Character              @relation("StanceFrom", fields: [fromCharacterId], references: [id], onDelete: Cascade)
  toCharacterId   String                 @map("to_character_id") @db.Uuid
  toCharacter     Character              @relation("StanceTo", fields: [toCharacterId], references: [id], onDelete: Cascade)
  stance          RelationshipStanceKind
  fromChapter     Int                    @map("from_chapter")
  toChapter       Int?                   @map("to_chapter")
  createdAt       DateTime               @default(now()) @map("created_at")

  @@index([fromCharacterId])
  @@index([toCharacterId])
  @@map("relationship_stances")
}

/// A group of characters bound together — a marriage, a harem, a
/// polyamorous web, a political alliance. This IS the spec's "relationship
/// groups" and "agreements": one table serves both because the domain
/// package models the whole shape as structure + members + window, and a
/// separate groups table would be a second name for the same rows.
///
/// `structure` names the shape, never the membership cap. Only MONOGAMY is
/// exclusive (EXCLUSIVE_STRUCTURES); a harem is uncapped because "harem"
/// describes a shape, not an instruction that every character becomes a
/// love interest. The exclusivity rule needs the sibling members of the
/// same bond, so it stays in validateBondStructures — no CHECK can see it.
model Bond {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Denormalised tenant boundary (ADR-0007).
  workspaceId String        @map("workspace_id") @db.Uuid
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  novelId     String        @map("novel_id") @db.Uuid
  novel       Novel         @relation(fields: [novelId], references: [id], onDelete: Cascade)
  structure   BondStructure
  fromChapter Int           @map("from_chapter")
  toChapter   Int?          @map("to_chapter")
  createdById String        @map("created_by_id") @db.Uuid
  createdBy   User          @relation("BondCreator", fields: [createdById], references: [id])
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  members      BondMember[]
  transitions  BondTransition[]
  interactions MeaningfulInteraction[]

  @@index([novelId])
  @@map("bonds")
}

/// Members are unordered — Bond.memberIds is "in no meaningful order", so
/// there is no position column. The unique index catches DUPLICATE_MEMBER.
model BondMember {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bondId      String    @map("bond_id") @db.Uuid
  bond        Bond      @relation(fields: [bondId], references: [id], onDelete: Cascade)
  characterId String    @map("character_id") @db.Uuid
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now()) @map("created_at")

  @@unique([bondId, characterId])
  @@index([characterId])
  @@map("bond_members")
}

/// A stage change on a bond: attraction → courtship → commitment →
/// marriage → legacy. A transition that moves the stage backwards must say
/// so (kind = REGRESS); the label check needs the previous row, so it is
/// validateBondLifecycle's, not a CHECK. Forward jumps are unrestricted —
/// a political marriage can go attraction → marriage in one chapter.
model BondTransition {
  id        String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bondId    String             @map("bond_id") @db.Uuid
  bond      Bond               @relation(fields: [bondId], references: [id], onDelete: Cascade)
  chapter   Int
  stage     BondStage
  kind      BondTransitionKind
  createdAt DateTime           @default(now()) @map("created_at")

  @@unique([bondId, chapter])
  @@map("bond_transitions")
}

/// Evidence that a bond actually moved, scored 0..1. Zero is a scene where
/// both were present and nothing happened — the case the spec's "not
/// simple chapter presence" rule is about, and why neglectReport reads
/// weight rather than counting chapters.
///
/// No novelId: neglect is a per-bond question and the bond already carries
/// the novel. workspaceId is here for the tenant filter (ADR-0007).
model MeaningfulInteraction {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Denormalised tenant boundary (ADR-0007).
  workspaceId String    @map("workspace_id") @db.Uuid
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  bondId      String    @map("bond_id") @db.Uuid
  bond        Bond      @relation(fields: [bondId], references: [id], onDelete: Cascade)
  chapter     Int
  /// 0..1 (CHECK in the migration). Not a score to optimise — the input
  /// MEANINGFUL_WEIGHT_FLOOR compares against.
  weight      Float
  summary     String?   @db.Text
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([bondId, chapter])
  @@map("meaningful_interactions")
}

// Phase 9 — Narrative DNA and antagonist persistence
// (DATA-MODEL-BLUEPRINT.md `## Narrative DNA`; docs/03-domain/
// NARRATIVE-DNA-AND-PLANNING.md and NARRATIVE-RHYTHM.md lines 23-37).
//
// The DNA profile is one JSONB row per novel, the same shape as
// PlanningHorizon: open-ended author preferences, always read and written as
// a unit. Policies are separate rows because ADR-009 needs *per-concern*
// hardness — "the drama gap is soft, the ending tone is hard" is a fact about
// one policy, not about the profile, and a hardness flag buried in free-form
// JSONB is a convention nothing enforces.
//
// Vocabulary below is pinned by packages/narrative-rhythm — changing a member
// there without the enum (or the reverse) must fail a test.

enum NarrativePolicyKind {
  DRAMA_GAP
  COOLDOWN
  SCALE
}

/// ADR-009 / NARRATIVE-DNA-AND-PLANNING.md: "Values are soft constraints
/// unless explicitly marked hard." A column rather than a JSONB convention, so
/// a reader can ask which policies actually bind without parsing payloads.
enum PolicyHardness {
  SOFT
  HARD
}

/// NARRATIVE-RHYTHM.md line 23: "Roles include MAIN, ARC, TEMPORARY, RIVAL,
/// IDEOLOGICAL, POLITICAL, PERSONAL, COMPETITOR."
enum AntagonistRole {
  MAIN
  ARC
  TEMPORARY
  RIVAL
  IDEOLOGICAL
  POLITICAL
  PERSONAL
  COMPETITOR
}

/// The nine-step lifecycle, verbatim: introduction → motivation → friction →
/// underestimation/conflict → escalation → confrontation → defeat/realization
/// → consequence → resolution. The doc writes two steps with a slash; one
/// member each is the faithful reading — the slash names one beat, not two.
enum AntagonistStage {
  INTRODUCTION
  MOTIVATION
  FRICTION
  UNDERESTIMATION
  ESCALATION
  CONFRONTATION
  DEFEAT
  CONSEQUENCE
  RESOLUTION
}

/// The twelve outcomes the doc lists, in its order. Nullable on the row: an
/// antagonist still in play has no outcome yet.
enum AntagonistOutcome {
  REGRET
  RESENTMENT
  RETREAT
  LOSS_OF_STATUS
  EXILE
  DEATH
  NEUTRALITY
  RESPECT
  REDEMPTION
  ALLIANCE
  SUBORDINATION
  FUTURE_REVENGE
}

/// Per-novel Narrative DNA: durable author preferences — genre/subgenre tags,
/// progression pace, protagonist competence, drama density, typical and
/// occasional extended drama gap, comedy/tragedy tolerance, romance structure,
/// face-slapping frequency, enemy-to-ally preference, political complexity,
/// technology realism, war frequency, ending tone, target length and whether
/// that length is hard or soft. NOT universal constants — each novel carries
/// its own JSONB, interpreted by packages/narrative-rhythm.
model NarrativeDnaProfile {
  novelId   String   @id @map("novel_id") @db.Uuid
  novel     Novel    @relation(fields: [novelId], references: [id], onDelete: Cascade)
  /// Shape validated in packages/narrative-rhythm, not by the database — the
  /// same contract as PlanningHorizon.policy.
  dna       Json
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("narrative_dna_profiles")
}

/// One named policy for one novel: DRAMA_GAP, COOLDOWN, SCALE. Split from the
/// DNA profile because hardness is per-concern (ADR-009) — "values are soft
/// constraints unless explicitly marked hard" binds one policy at a time.
model NarrativePolicy {
  id          String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  novelId     String              @map("novel_id") @db.Uuid
  novel       Novel               @relation(fields: [novelId], references: [id], onDelete: Cascade)
  kind        NarrativePolicyKind
  hardness    PolicyHardness
  /// Why this policy binds. Required when hardness = HARD (CHECK in the
  /// migration): an override with no stated reason is the unauditable
  /// free-form case the hardness column exists to avoid.
  hardReason  String?             @db.Text @map("hard_reason")
  /// Shape owned by packages/narrative-rhythm, interpreted per kind.
  payload     Json
  updatedAt   DateTime            @updatedAt @map("updated_at")

  @@unique([novelId, kind])
  @@map("narrative_policies")
}

/// An antagonist: a Character cast in an opposing role, tracked through the
/// nine-step lifecycle with an explicit purpose and a chapter span. Linked to
/// Character rather than duplicating name/summary — the antagonist *is* the
/// character; this row records what the story does with them.
model Antagonist {
  id          String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Denormalised tenant boundary, matching CanonFact and Phase 8 (ADR-0007):
  /// a filtered query never joins to enforce isolation.
  workspaceId String             @map("workspace_id") @db.Uuid
  workspace   Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  novelId     String             @map("novel_id") @db.Uuid
  novel       Novel              @relation(fields: [novelId], references: [id], onDelete: Cascade)
  characterId String             @map("character_id") @db.Uuid
  character   Character          @relation(fields: [characterId], references: [id], onDelete: Cascade)
  role        AntagonistRole
  stage       AntagonistStage    @default(INTRODUCTION)
  /// Null until the arc closes.
  outcome     AntagonistOutcome?
  /// Why they oppose the protagonist. Required for TEMPORARY roles (CHECK in
  /// the migration): "Temporary antagonists may exist for ~5-20 chapters when
  /// appropriate. Their purpose must be explicit."
  purpose     String?            @db.Text
  /// Inclusive first chapter the antagonist is in play.
  fromChapter Int                @map("from_chapter")
  /// Inclusive last chapter; null = still in play.
  toChapter   Int?               @map("to_chapter")
  createdById String             @map("created_by_id") @db.Uuid
  createdBy   User               @relation("AntagonistCreator", fields: [createdById], references: [id])
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")

  @@unique([novelId, characterId])
  @@index([characterId])
  @@map("antagonists")
}
