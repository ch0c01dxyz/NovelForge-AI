{"$schema":"http://json-schema.org/draft-07/schema#","additionalProperties":true,"description":"Candidate facts/state/events extracted from the final chapter artifact. Proposals are CANDIDATES only — nothing here writes canon. Every proposal must carry at least one citation (enforced via `contains`; the schema compiler does not support `minItems`).","properties":{"proposals":{"items":{"additionalProperties":true,"properties":{"citations":{"contains":{"properties":{"source":{"minLength":1,"type":"string"},"span":{"minLength":1,"type":"string"}},"required":["source","span"],"type":"object"},"items":{"additionalProperties":true,"properties":{"source":{"minLength":1,"type":"string"},"span":{"minLength":1,"type":"string"}},"required":["source","span"],"type":"object"},"type":"array"},"kind":{"enum":["fact","state","event","relationship"],"type":"string"},"text":{"minLength":1,"type":"string"}},"required":["kind","text","citations"],"type":"object"},"type":"array"}},"required":["proposals"],"title":"Chapter extraction proposals","type":"object"}